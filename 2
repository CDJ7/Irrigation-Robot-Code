// ==================================================
// Function Prototypes -----------------------------+
void setupWiFi();
void reconnect();
void setThrottle(int dacPin, float duty01);
void pumpControls(bool on);
void set3Speed(int gear);
void setReverse(bool side, bool rev);
void setBrake(bool on);
void move_control(int forward, int steer, bool stop);
void callback(char* topic, byte* payload, unsigned int length);
void ibusLoop();

IBusBM ibus;
int mode = 0;
bool armed = false;

// ---------------- PIN DEFINITIONS ----------------

#define IBUS_RX_PIN 16

// DAC
#define L_DAC 25
#define R_DAC 26

#define PUMP_PIN    17    

// Motor control pins
#define REV_LEFT    32
#define REV_RIGHT   33
#define SP_HIGH     23
#define SP_LOW      22      
#define BRAKE       21

const float Vmin    = 1.15;
const float Vmax    = 3.30;
const float VdacMax = 3.30;

const bool LEFTM = true;
const bool RIGHTM = false;

float L_throttle;
float R_throttle;

bool L_rev;
bool R_rev;

bool pumpState = false;      
bool lastPumpSwitch = false;  

// ---------------- READ IBUS CHANNEL ----------------
int readChannel(byte channelInput, int minLimit, int maxLimit, int defaultValue) {
  uint16_t ch = ibus.readChannel(channelInput);
  if (ch < 100) return defaultValue;
  return map(ch, 1000, 2000, minLimit, maxLimit);
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);
  delay(3000);

  pinMode(REV_LEFT, OUTPUT);
  pinMode(REV_RIGHT, OUTPUT);
  pinMode(BRAKE, OUTPUT);
  pinMode(PUMP_PIN, OUTPUT);
 
  pinMode(SP_HIGH, INPUT);
  pinMode(SP_LOW, INPUT);

  setupWiFi();

  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);

  delay(1000);

  Serial2.begin(115200, SERIAL_8N1, IBUS_RX_PIN, -1);
  delay(100);  
  ibus.begin(Serial2);
  Serial.println("iBus receiver initialized.");

  // --- FIXED: Both Reverse Pins must start LOW for Forward ---
  digitalWrite(REV_LEFT, LOW);
  digitalWrite(REV_RIGHT, LOW); // Was HIGH, now LOW
  digitalWrite(BRAKE, LOW);
  set3Speed(1);
  digitalWrite(PUMP_PIN, LOW);
  Serial.println("All commands off/Forward Mode Initialized");

  delay(1000);
}

// ---------------- MAIN LOOP ----------------
void loop()
{
  int arm = readChannel(4, 0, 100, 0);  
  mode = readChannel(5, 0, 100, 0);    

  if (arm != 0) {
    if(!armed) {
        Serial.println("Armed!");
        armed = true;
        setBrake(false);
    }

    if (mode != 0) {
      if (!client.connected()) {
          reconnect();
      } else {
          client.loop();
      }
    } else {
      ibusLoop();
    }

  } else {
    if(armed) {
      Serial.println("Disarmed! Stopping motors.");
      setThrottle(L_DAC, 0);
      setThrottle(R_DAC, 0);
      digitalWrite(REV_LEFT, LOW);
      digitalWrite(REV_RIGHT, LOW);
      digitalWrite(PUMP_PIN, LOW);
      setBrake(true);
      armed = false;
    }
    delay(50);
  }
}

// ---------------- WIFI & MQTT FUNCTIONS ----------------
void setupWiFi() {
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
