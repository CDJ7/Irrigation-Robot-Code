# Keep Unix line endings in the checkout, even on Windows. Windows line endings (CRLF) break shell scripts and
# systemd unit files on the Raspberry Pi ("set: Illegal option -").
*.sh      text eol=lf
*.service text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.ino     text eol=lf
*.md      text eol=lf
